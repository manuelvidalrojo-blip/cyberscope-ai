# ─────────────────────────────────────────────────────────────────────────────
# CyberScope AI · configuración de ejemplo
# Copia este fichero a .env y cambia los valores. .env NUNCA se sube al repo.
# ─────────────────────────────────────────────────────────────────────────────

# Administrador inicial: se crea solo si la base de datos no tiene usuarios.
# Contraseña: mínimo 12 caracteres con letras y números. CÁMBIALA.
CYBERSCOPE_ADMIN_USER=admin
CYBERSCOPE_ADMIN_PASSWORD=CambiaEstaClave2026

# Resumen ejecutivo con IA (opcional). Sin clave se usa el resumen por reglas.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Límite de análisis por usuario y ventana de tiempo
RATE_LIMIT_ANALYSES=10
RATE_LIMIT_WINDOW_MIN=10

# Sesión e historial
SESSION_TIMEOUT_MIN=30
AUDIT_RETENTION_DAYS=90
DATA_DIR=data

# Hosts de laboratorio que se pueden analizar aunque tengan IP privada
# (separados por comas). Déjalo vacío en producción.
LAB_HOSTS=

# Solo para docker-compose con Caddy: dominio público (HTTPS automático)
# o ":80" para servir por HTTP en una IP sin dominio.
SITE_ADDRESS=:80
